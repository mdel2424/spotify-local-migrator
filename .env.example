# Copy to .env; keep credentials on your own computer.
# PKCE needs the Client ID only. Do not store a Client Secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback
SPOTIFY_DATA_DIR=data
SPOTIFY_TOKEN_PATH=.spotify-local-migrate/tokens.json
# Space API attempts and automatically wait out Spotify's cooldowns.
SPOTIFY_REQUEST_INTERVAL_SECONDS=3
SPOTIFY_WAIT_FOR_RATE_LIMITS=true
